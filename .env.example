# Interview / Calendar Booking URL (Calendly, Cal.com, etc.)
# If left empty, the "Schedule an Interview" buttons smoothly scroll to the contact form.
VITE_BOOKING_URL=https://calendly.com/your-username/15min

# Formspree endpoint (optional)
# Example: https://formspree.io/f/xbjvlqwe
VITE_FORMSPREE_ENDPOINT=

# EmailJS Configuration (alternative option)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Optional Google Analytics ID
VITE_ANALYTICS_ID=
